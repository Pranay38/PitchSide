# Admin
VITE_ADMIN_PASSWORD=your-admin-password

# Clerk (Lightweight Auth)
# Get your publishable key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# Google Analytics 4 — get from https://analytics.google.com (Admin > Data Streams > Measurement ID)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console — get from https://search.google.com/search-console (Settings > Ownership verification > HTML tag)
VITE_GOOGLE_SITE_VERIFICATION=your-verification-code

# MongoDB (used by Vercel Serverless Functions)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pitchside

# Push Notifications (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@pitchside.app
