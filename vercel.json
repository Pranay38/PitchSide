{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "X-XSS-Protection", "value": "1; mode=block" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://platform.twitter.com https://www.instagram.com https://connect.facebook.net https://www.tiktok.com https://challenges.cloudflare.com https://*.clerk.accounts.dev https://clerk.thetouchlinedribble.in https://*.clerk.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.clerk.accounts.dev https://*.clerk.com; font-src 'self' https://fonts.gstatic.com https://*.clerk.com; img-src 'self' data: blob: https: http:; connect-src 'self' https: wss:; frame-src https://www.youtube.com https://platform.twitter.com https://www.instagram.com https://www.tiktok.com https://www.sofascore.com https://widget.sofascore.com https://challenges.cloudflare.com https://*.clerk.accounts.dev https://*.clerk.com; media-src 'self' https:; object-src 'none'; base-uri 'self'" }
            ]
        }
    ],
    "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sys?route=sitemap"
    },
    {
      "source": "/api/daily-features",
      "destination": "/api/sys?route=daily-features"
    },
    {
      "source": "/api/polls/:id/vote",
      "destination": "/api/sys?action=polls-vote&id=:id"
    },
    {
      "source": "/api/polls/:id",
      "destination": "/api/sys?action=polls&id=:id"
    },
    {
      "source": "/api/polls",
      "destination": "/api/sys?action=polls"
    },
    {
      "source": "/api/match-ratings/:id/vote",
      "destination": "/api/sys?action=match-ratings-vote&id=:id"
    },
    {
      "source": "/api/match-ratings/:id",
      "destination": "/api/sys?action=match-ratings&id=:id"
    },
    {
      "source": "/api/match-ratings",
      "destination": "/api/sys?action=match-ratings"
    },
        {
            "source": "/api/on-this-day",
            "destination": "/api/sys?route=on-this-day"
        },
        {
            "source": "/api/run-in",
            "destination": "/api/sys?route=run-in"
        },
        {
            "source": "/api/title-race",
            "destination": "/api/sys?route=title-race"
        },
        {
            "source": "/api/predictions",
            "destination": "/api/sys?route=predictions"
        },
        {
            "source": "/api/poll-of-week",
            "destination": "/api/sys?route=poll-of-week"
        },
        {
            "source": "/api/auth",
            "destination": "/api/sys?route=auth"
        },
        {
            "source": "/api/settings",
            "destination": "/api/sys?route=settings"
        },
        {
            "source": "/api/subscribers",
            "destination": "/api/sys?route=subscribers"
        },
        {
            "source": "/api/notify",
            "destination": "/api/sys?route=notify"
        },
        {
            "source": "/api/collections",
            "destination": "/api/sys?route=collections"
        },
        {
            "source": "/api/debates",
            "destination": "/api/sys?route=debates"
        },
        {
            "source": "/api/tactics",
            "destination": "/api/sys?route=tactics"
        },
        {
            "source": "/api/club-season",
            "destination": "/api/sys?route=club-season"
        },
        {
            "source": "/api/og",
            "destination": "/api/sys?route=og"
        },
        {
            "source": "/api/ai-generate",
            "destination": "/api/sys?route=ai-generate"
        },
        {
            "source": "/api/generate-carousel",
            "destination": "/api/sys?route=generate-carousel"
        },
        {
            "source": "/api/analytics",
            "destination": "/api/sys?route=analytics"
        },
        {
            "source": "/api/digest",
            "destination": "/api/sys?route=digest"
        },
        {
            "source": "/api/transfers",
            "destination": "/api/sys?route=transfers"
        },
        {
            "source": "/api/user-prefs",
            "destination": "/api/sys?route=user-prefs"
        },
        {
            "source": "/api/error-log",
            "destination": "/api/sys?route=error-log"
        },
        {
            "source": "/api/rss",
            "destination": "/api/sys?route=rss"
        },
        {
            "source": "/api/football-data",
            "destination": "/api/sys?route=football-data"
        },
        {
            "source": "/api/search",
            "destination": "/api/sys?route=search"
        },
        {
            "source": "/api/ensure-indexes",
            "destination": "/api/sys?route=ensure-indexes"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/digest",
            "schedule": "0 10 * * 0"
        },
        {
            "path": "/api/daily-features",
            "schedule": "0 6 * * *"
        }
    ]
}
