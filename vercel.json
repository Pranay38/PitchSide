{
    "rewrites": [

    {
      "source": "/api/polls/:id/vote",
      "destination": "/api/sys?action=polls-vote&id=:id"
    },
    {
      "source": "/api/polls/:id",
      "destination": "/api/sys?action=polls&id=:id"
    },
    {
      "source": "/api/polls",
      "destination": "/api/sys?action=polls"
    },
    {
      "source": "/api/match-ratings/:id/vote",
      "destination": "/api/sys?action=match-ratings-vote&id=:id"
    },
    {
      "source": "/api/match-ratings/:id",
      "destination": "/api/sys?action=match-ratings&id=:id"
    },
    {
      "source": "/api/match-ratings",
      "destination": "/api/sys?action=match-ratings"
    },
        {
            "source": "/api/on-this-day",
            "destination": "/api/sys?route=on-this-day"
        },
        {
            "source": "/api/run-in",
            "destination": "/api/sys?route=run-in"
        },
        {
            "source": "/api/predictions",
            "destination": "/api/sys?route=predictions"
        },
        {
            "source": "/api/poll-of-week",
            "destination": "/api/sys?route=poll-of-week"
        },
        {
            "source": "/api/auth",
            "destination": "/api/sys?route=auth"
        },
        {
            "source": "/api/settings",
            "destination": "/api/sys?route=settings"
        },
        {
            "source": "/api/subscribers",
            "destination": "/api/sys?route=subscribers"
        },
        {
            "source": "/api/notify",
            "destination": "/api/sys?route=notify"
        },
        {
            "source": "/api/collections",
            "destination": "/api/sys?route=collections"
        },
        {
            "source": "/api/debates",
            "destination": "/api/sys?route=debates"
        },
        {
            "source": "/api/tactics",
            "destination": "/api/sys?route=tactics"
        },
        {
            "source": "/api/club-season",
            "destination": "/api/sys?route=club-season"
        },
        {
            "source": "/api/og",
